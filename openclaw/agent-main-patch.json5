// OpenClaw Main Agent Configuration Patch: main agent
// Location: ~/.openclaw/openclaw.json5 (under agents.entries.main)
//
// Purpose: Configure subagent delegation constraints on the main agent.
// - requireAgentId: true forces explicit target specification on every sessions_spawn call.
// - allowAgents: [...existing, "archivist"] preserves existing allowed agents and adds archivist.
// - Note: Ensure "personal-archive" is NOT in main's skill list (skills) so main cannot execute the CLI directly.
//
// Verified Schema Note:
// All keys verified against OpenClaw 2026.9.5 schema.

{
  agents: {
    entries: {
      "main": {
        subagents: {
          // [VERIFIED ON OPENCLAW 2026.9.5]: forces explicit agentId on sessions_spawn (optional hardening)
          requireAgentId: true,
          // [VERIFIED ON OPENCLAW 2026.9.5]: preserve existing allowed agents and add "archivist"
          allowAgents: [
            "archivist"
          ]
        }
        // [VERIFIED ON OPENCLAW 2026.9.5]: ensure "personal-archive" is NOT in main's skills list
        // so main's prompt does not load personal-archive CLI execution instructions:
        // skills: ["...other skills...", /* NOT personal-archive */]
      }
    }
  }
}
