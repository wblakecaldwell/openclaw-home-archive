// OpenClaw Agent Definition: archivist
// Location: ~/.openclaw/openclaw.json5 (under agents.entries)
//
// Purpose: Dedicated, isolated domain agent for durable personal records and evidence.
// This agent runs in its own workspace without access to conversational chat history,
// dreaming summaries, or main agent memory files.
//
// Security & Hardening:
// Shell execution (exec), write, and generic filesystem read are denied. The agent interacts with the archive
// solely via native Model Context Protocol (MCP) tools provided by the personal-archive server.

{
  agents: {
    entries: {
      "archivist": {
        name: "Archivist",
        description: "Isolated factual agent responsible for durable personal records and evidence.",
        // Lightweight, local image-aware model suitable for structured evidence extraction
        model: "lmstudio/google/gemma-4-e4b",
        workspace: "~/.openclaw/workspaces/archivist",
        tools: {
          allow: [
            "personal-archive/*"
          ],
          deny: [
            "read",
            "exec",
            "write",
            "group:sessions",
            "group:memory",
            "web_search",
            "browser",
            "edit",
            "apply_patch"
          ]
        },
        skills: [
          "personal-archive"
        ],
        memory: {
          search: {
            rememberAcrossConversations: false
          }
        },
        subagents: {
          allowAgents: []
        }
      }
    }
  }
}
