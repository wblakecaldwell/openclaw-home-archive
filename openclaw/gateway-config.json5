// OpenClaw Gateway Configuration: Gateway-Wide Settings
// Location: ~/.openclaw/openclaw.json5
//
// Verified Schema Note:
// All keys verified against OpenClaw 2026.9.5 schema.

{
  tools: {
    sessions: {
      // [VERIFIED ON OPENCLAW 2026.9.5]: "tree" restricts child agents from discovering
      // sibling/parent sessions while preserving parent control over spawned subagents.
      visibility: "tree"
    },
    agentToAgent: {
      // [VERIFIED ON OPENCLAW 2026.9.5]: disables interactive cross-agent messaging.
      // OpenClaw docs confirm: "Requester-owned native subagent and ACP child sessions stay reachable under tree or all visibility."
      enabled: false
    }
  },
  skills: {
    entries: {
      "home-archive": {
        env: {
          // [VERIFIED IN REPO / STANDARD OPENCLAW KEY]:
          // Authoritative archive storage root outside Git.
          HOME_ARCHIVE_ROOT: "~/Documents/OpenClaw/HomeArchive"
        }
      }
    }
  },
  plugins: {
    entries: {
      // [VERIFIED ON OPENCLAW 2026.9.5]: active-memory plugin is active and already scoped to:
      // agents: ["main"], ensuring home-archive is completely excluded from memory injection.
      "active-memory": {
        config: {
          agents: [
            "main"
          ]
        }
      }
    }
  }
}

